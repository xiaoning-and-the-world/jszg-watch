{
  "_说明": "这是模板：复制成 config.json 后在本地用；GitHub Actions 上不要提交 config.json，改用仓库 Secrets（见 README）。",
  "enabled": true,

  "channels": {
    "serverchan": {
      "enabled": false,
      "sendkey": "SERVERCHAN_SENDKEY_HERE"
    },
    "pushplus": {
      "enabled": false,
      "token": "PUSHPLUS_TOKEN_HERE"
    }
  },

  "notify": {
    "always_notify": false,
    "notify_non_focus": true,
    "recent_count": 5
  },

  "watch": {
    "list_url": "https://www.zjzs.net/col/col62/index.html",
    "column_name": "中小学教师资格认定及定期注册",
    "focus_keywords": ["教师资格认定"],
    "extra_keywords": [],
    "digest_new": true,
    "digest_max": 10,
    "removal_confirm_days": 7,
    "page_delay": 0.5,
    "timeout": 30,
    "retries": 3,
    "retry_delay": 3,
    "allow_insecure_ssl": true
  },

  "report": {
    "keep_last": 120
  }
}
